{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "$engine/*": ["src/lib/engine/*"],
      "$games/*": ["src/lib/games/*"],
      "$store/*": ["src/lib/store/*"],
      "$lib/*": ["src/lib/*"]
    }
  }
}

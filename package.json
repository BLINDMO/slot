{
  "name": "slot-hub",
  "version": "0.1.0",
  "description": "Single-player slot machine hub PWA — virtual currency only, no real-money wagering.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "sim": "tsx --tsconfig tsconfig.scripts.json scripts/simulate.ts",
    "sim:instant": "tsx --tsconfig tsconfig.scripts.json scripts/instant.ts",
    "test": "tsx --tsconfig tsconfig.scripts.json scripts/test.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^25.9.3",
    "@vite-pwa/sveltekit": "^0.6.0",
    "svelte": "^5.2.0",
    "svelte-check": "^4.1.0",
    "tslib": "^2.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "howler": "^2.2.4",
    "idb-keyval": "^6.2.1",
    "pixi.js": "^8.5.0"
  }
}
